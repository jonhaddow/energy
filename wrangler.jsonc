{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "energy",
	"compatibility_date": "2026-10-03",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Only served on energy.app.haddow.me (Google sign-in only allows that address).
	"workers_dev": false,
	"routes": [{ "pattern": "energy.app.haddow.me", "custom_domain": true }],
	// Keeps request logs and console output (Workers Logs, free tier) for debugging.
	"observability": {
		"enabled": true
	},
	"triggers": {
		// Hourly Bright sync (worker/entry.js)
		"crons": ["23 * * * *"]
	},
	"vars": {
		"APP_ORIGIN": "https://energy.app.haddow.me",
		// Public OAuth client ID; the secret is a Worker secret (GOOGLE_CLIENT_SECRET).
		"GOOGLE_CLIENT_ID": "856408914710-dgcs4pkdkahr6jchr0pefodiobhjrmv4.apps.googleusercontent.com"
	},
	// Off: branch previews would share the live D1 database.
	"preview_urls": false,
	"d1_databases": [
		{
			// Created with --jurisdiction eu, so the data stays in the EU.
			"binding": "DB",
			"database_name": "energy",
			"database_id": "b199d7f5-dcb7-479d-87ea-ee2123cabeff",
			"migrations_dir": "drizzle"
		}
	]
}
